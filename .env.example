# ---------------------------------------------------------------------------
# OpenRouter
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
# Both models are decision models: they are served by the Decisions API, not chat/completions.
OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
# Sent as HTTP-Referer / X-Title headers (OpenRouter app attribution)
APP_REFERER=http://localhost:8000
APP_TITLE=JEV vs KEV Triage

# ---------------------------------------------------------------------------
# Models under comparison
# ---------------------------------------------------------------------------
# Baseline
JEV_MODEL=typesafe/jev-1.14
JEV_LABEL=JEV 1.14
# Challenger
KEV_MODEL=jaredpalmer/kev-4b
KEV_LABEL=KEV 4B

# Optional provider routing (OpenRouter `provider` preferences). Leave empty for default routing.
# OpenRouter may spread a model across several providers with very different latency
# (e.g. KEV on SiliconFlow vs Phala). Pin or exclude providers for a fair, stable comparison.
#   *_PROVIDER_ORDER   comma list, tried in this order      e.g. SiliconFlow,Phala
#   *_PROVIDER_ONLY    comma list, only these are allowed   e.g. SiliconFlow
#   *_PROVIDER_IGNORE  comma list, never use these          e.g. Phala
#   *_PROVIDER_SORT    price | throughput | latency
#   *_ALLOW_FALLBACKS  true | false (use other providers if the preferred ones fail)
JEV_PROVIDER_ORDER=
JEV_PROVIDER_ONLY=
JEV_PROVIDER_IGNORE=
JEV_PROVIDER_SORT=
JEV_ALLOW_FALLBACKS=
KEV_PROVIDER_ORDER=
KEV_PROVIDER_ONLY=
KEV_PROVIDER_IGNORE=
KEV_PROVIDER_SORT=
KEV_ALLOW_FALLBACKS=

# Optional pricing fallback (USD per 1M tokens). Used only when OpenRouter
# does not return usage.cost in the response (it normally does).
JEV_PRICE_IN=
JEV_PRICE_OUT=
KEV_PRICE_IN=
KEV_PRICE_OUT=

# ---------------------------------------------------------------------------
# Human-in-the-loop
# ---------------------------------------------------------------------------
# A ticket needs human review when the team confidence OR the NOUL (criticality)
# confidence max(P, 1-P) is below this.
HITL_CONFIDENCE_THRESHOLD=0.80
# Which confidences are checked against the threshold (default for new runs; selectable in the UI):
#   team_or_critical -> team confidence OR NOUL (criticality) confidence   [option 1]
#   team             -> team confidence only                                 [option 2]
#   critical         -> NOUL (criticality) confidence only                   [option 3]
# Failed calls and invalid answers always go to human review.
HITL_MODE=team_or_critical

# ---------------------------------------------------------------------------
# Batch / reliability
# ---------------------------------------------------------------------------
BATCH_CONCURRENCY=4
# Run every ticket N times per model to measure consistency (1 = single run)
RUNS_PER_TICKET=1
MAX_RETRIES=3
REQUEST_TIMEOUT_S=60

# ---------------------------------------------------------------------------
# Verdict: "Can KEV replace JEV?"
# ---------------------------------------------------------------------------
# Minimum full agreement rate (team + NOUL) between KEV and JEV
VERDICT_MIN_AGREEMENT=0.85
# Maximum allowed increase of KEV's human-review rate over JEV's (absolute)
VERDICT_MAX_HITL_DELTA=0.05
# Maximum allowed accuracy drop vs JEV when ground truth is available (absolute)
VERDICT_MAX_ACCURACY_DROP=0.05
